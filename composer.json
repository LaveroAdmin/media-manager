{
    "name": "laveroadmin/media-manager",
    "description": "Media manager for LaveroAdmin",
    "type": "library",
    "keywords": [
        "lavero-admin",
        "media",
        "manager"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=7.3",
        "laveroadmin/laveroadmin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\Media\\": "src/"
        }
